<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_consignment_return_document">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <h2>
                            Consignment Return:
                            <span t-esc="o.name"/>
                        </h2>

                        <p>
                            Vendor:
                            <span t-esc="o.vendor_id.name"/>
                        </p>

                        <p>
                            Purchase Order:
                            <span t-esc="o.purchase_id.name"/>
                        </p>

                        <p>
                            Date:
                            <span t-esc="o.date"/>
                        </p>

                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Qty</th>
                                    <th>Unit Price</th>
                                    <th>Return Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l">
                                    <td>
                                        <span t-esc="l.product_id.display_name"/>
                                    </td>
                                    <td>
                                        <span t-esc="l.quantity"/>
                                    </td>
                                    <td>
                                        <span t-esc="l.price_unit"/>
                                    </td>
                                    <td>
                                        <span t-esc="l.price_subtotal"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <p>
                            Total Return Value:
                            <span t-esc="o.total_return_value"/>
                        </p>

                        <p>
                            Notes:
                            <span t-esc="o.note"/>
                        </p>
                    </div>
                </t>
            </t>
        </template>

        <record id="consignment_return_report" model="ir.actions.report">
            <field name="name">Consignment Return</field>
            <field name="model">consignment.return</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mavaziconsignment.report_consignment_return_document</field>
            <field name="report_file">mavaziconsignment.report_consignment_return_document</field>
            <field name="print_report_name">'ConsignmentReturn_' + object.name</field>
            <field name="binding_model_id" ref="model_consignment_return"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>