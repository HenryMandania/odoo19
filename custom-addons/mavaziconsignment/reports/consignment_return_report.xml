<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_consignment_return" model="ir.actions.report">
            <field name="name">Consignment Return</field>
            <field name="model">consignment.return</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mavaziconsignment.report_consignment_return_document</field>
            <field name="report_file">mavaziconsignment.report_consignment_return_document</field>
            <field name="print_report_name">'ConsignmentReturn_%s' % (object.name)</field>
            <field name="binding_model_id" ref="model_consignment_return"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_consignment_return_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>
                            
                            <h2>Consignment Return: <span t-field="o.name"/></h2>
                            
                            <div class="row mt-4 mb-4">
                                <div class="col-6">
                                    <strong>Vendor:</strong> <span t-field="o.vendor_id.name"/><br/>
                                    <strong>Purchase Order:</strong> <span t-field="o.purchase_id.name"/>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Date:</strong> <span t-field="o.date"/>
                                </div>
                            </div>

                            <table class="table table-sm mt-4">
                                <thead>
                                    <tr class="border-black">
                                        <th>Product</th>
                                        <th class="text-end">Qty</th>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-end">Return Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_ids" t-as="l">
                                        <tr>
                                            <td><span t-field="l.product_id.display_name"/></td>
                                            <td class="text-end"><span t-field="l.quantity"/></td>
                                            <td class="text-end">
                                                <span t-field="l.price_unit" t-options='{"widget": "monetary", "display_currency": o.env.company.currency_id}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="l.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.env.company.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table >

                            <div class="row justify-content-end">
                                <div class="col-4">
                                    <table class="table table-sm">
                                        <tr class="border-black fw-bold">
                                            <td><strong>Total Return Value</strong></td>
                                            <td class="text-end">
                                                <span t-field="o.total_return_value" t-options='{"widget": "monetary", "display_currency": o.env.company.currency_id}'/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <div t-if="o.note" class="mt-4">
                                <strong>Notes:</strong>
                                <p t-field="o.note"/>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>