<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_consignment_return_tree" model="ir.ui.view">
            <field name="name">consignment.return.list</field>
            <field name="model">consignment.return</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'draft'">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="vendor_id"/>
                    <field name="purchase_id"/>
                    <field name="total_return_value" sum="Total"/>
                    <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'"/>
                </list>
            </field>
        </record>

        <record id="view_consignment_return_form" model="ir.ui.view">
            <field name="name">consignment.return.form</field>
            <field name="model">consignment.return</field>
            <field name="arch" type="xml">
                <form string="Consignment Return">
                    <header>
                        <button name="action_confirm"
                                type="object"
                                string="Confirm"
                                class="btn-primary"
                                invisible="state != 'draft'"/>
                        
                        <button name="print_return"
                                type="object"
                                string="Print"
                                class="btn-secondary"
                                invisible="state == 'draft'"/>
                        
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="vendor_id" readonly="state == 'confirmed'"/>
                                <field name="purchase_id" readonly="state == 'confirmed'"/>
                            </group>
                            <group>
                                <field name="date" readonly="state == 'confirmed'"/>
                                <field name="total_return_value" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Returned Items" name="items">
                                <field name="line_ids" readonly="state == 'confirmed'">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="remaining_qty" readonly="1"/>
                                        <field name="quantity"/>
                                        <field name="price_unit"/>
                                        <field name="price_subtotal" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="note" placeholder="Add internal notes here..." />
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_consignment_return" model="ir.actions.act_window">
            <field name="name">Consignment Returns</field>
            <field name="res_model">consignment.return</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Consignment Return
                </p>
            </field>
        </record>

        <menuitem id="menu_consignment_root"
                  name="Consignment"
                  parent="purchase.menu_purchase_root"
                  sequence="25"/>

        <menuitem id="menu_consignment_return"
                  name="Returns"
                  parent="menu_consignment_root"
                  action="action_consignment_return"
                  sequence="10"/>
    </data>
</odoo>