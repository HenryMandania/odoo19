<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consignment_sales_report_wizard_form" model="ir.ui.view">
        <field name="name">consignment.sales.report.wizard.form</field>
        <field name="model">consignment.sales.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Consignment Sales Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="vendor_id" options="{'no_create': True}"/>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="output_type" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Generate Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_consignment_sales_report_wizard" model="ir.actions.act_window">
        <field name="name">Consignment Sales Report</field>
        <field name="res_model">consignment.sales.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

<!-- Original Purchase Reports Menu -->
<menuitem id="menu_consignment_reports_category" 
          name="Consignment Reports" 
          parent="purchase.purchase_report_main" 
          sequence="100"/>

<menuitem id="menu_consignment_sales_report_link"
          name="Consignment Sales Report"
          parent="menu_consignment_reports_category"
          action="action_consignment_sales_report_wizard"
          sequence="10"/>

<!-- Memorised Reports Menu -->
<menuitem id="menu_memorised_consignment_sales_report"
          name="Consignment Sales Report"
          parent="memorised_reports.menu_mavazi_by_safeway_reports"
          action="action_consignment_sales_report_wizard"
          sequence="30"/>
</odoo>