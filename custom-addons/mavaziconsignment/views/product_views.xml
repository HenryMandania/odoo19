<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_view_inherit_consignment" model="ir.ui.view">
            <field name="name">product.template.form.inherit.consignment</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='type']" position="after">
                    <field name="x_is_consignment" widget="boolean_toggle"/>
                </xpath>

                <xpath expr="//field[@name='type']" position="attributes">
                    <attribute name="readonly">x_is_consignment</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>

                <xpath expr="//field[@name='tracking']" position="attributes">
                    <attribute name="readonly">x_is_consignment</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>