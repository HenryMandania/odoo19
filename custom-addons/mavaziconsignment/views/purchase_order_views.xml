<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_view_inherit_consignment" model="ir.ui.view">
            <field name="name">product.template.form.inherit.consignment</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="after">
                    <field name="x_is_consignment" widget="boolean_toggle"/>
                </xpath>

                <xpath expr="//field[@name='type']" position="attributes">
                    <attribute name="readonly">x_is_consignment</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>
                <xpath expr="//field[@name='tracking']" position="attributes">
                    <attribute name="readonly">x_is_consignment</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_form_inherit_vendor_filter" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.vendor.filter</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                    <attribute name="domain">[('seller_ids.partner_id', '=', parent.partner_id)]</attribute>
                    <attribute name="context">{'partner_id': parent.partner_id, 'tree_view_ref': 'product.product_product_tree_view'}</attribute>
                    <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_consignment_report_line_temp_tree" model="ir.ui.view">
            <field name="name">consignment.sales.report.line.temp.list</field>
            <field name="model">consignment.sales.report.line.temp</field>
            <field name="arch" type="xml">
                <list string="Consignment Sales Report" export_xlsx="1" create="0" edit="0" delete="0">
                    <field name="vendor_name"/>
                    <field name="item_number"/>
                    <field name="item_name"/>
                    <field name="qty_sold" sum="Total Qty"/>
                    <field name="net_sales" sum="Total Net" widget="monetary"/>
                    <field name="vat_amount" sum="Total VAT" widget="monetary"/>
                    <field name="gross_amount" sum="Total Gross" widget="monetary"/>
                </list>
            </field>
        </record>
    </data>
</odoo>