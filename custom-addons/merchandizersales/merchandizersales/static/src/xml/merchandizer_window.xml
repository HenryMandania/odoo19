<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="MerchandizerWindow" owl="1">
        <div class="merchandizer-overlay">
            <div class="merchandizer-window">

                <div class="header">
                    <h3>Select Sales Staff</h3>
                    <span class="close" t-on-click="close">x</span>
                </div>

                <input
                    class="search"
                    t-model="state.search"
                    placeholder="Search by name or code..."
                />

                <div class="body">
                    <t t-if="state.loading">
                        <div class="loading">Loading...</div>
                    </t>

                    <t t-foreach="filteredMerchandizers" t-as="m" t-key="m.id">
                        <div
                            class="row"
                            t-att-class="{ selected: state.selected &amp;&amp; state.selected.id === m.id }"
                            t-on-click="selectMerchandizer"
                            t-att-data-id="m.id"
                        >
                            <strong t-esc="m.code"/> - <t t-esc="m.name"/>
                        </div>
                    </t>
                </div>

                <div class="footer">
                    <button class="cancel" t-on-click="close">Cancel</button>
                    <button
                        class="confirm"
                        t-on-click="confirm"
                        t-att-disabled="!state.selected"
                    >
                        Confirm
                    </button>
                </div>

            </div>
        </div>
    </t>

</templates>