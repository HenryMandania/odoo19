<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="point_of_sale.menu_report_pos_order_all" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="action_report_merchandizer_pdf" model="ir.actions.report">
        <field name="name">Merchandizer Sales Report (PDF)</field>
        <field name="model">sales.staff.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">merchandizersales.report_sales_staff_template</field>
        <field name="report_file">merchandizersales.report_sales_staff_template</field>
        <field name="binding_model_id" ref="model_sales_staff_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_merchandizer_report_wizard" model="ir.actions.act_window">
        <field name="name">Merchandizer Sales Report</field>
        <field name="res_model">sales.staff.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem 
        id="menu_merchandizer_reporting_root"
        name="Merchandizer Reports"
        parent="point_of_sale.menu_point_rep"
        sequence="10"/>

    <menuitem 
        id="menu_report_merchandizer_wizard"
        name="Merchandizer Sales Analysis"
        parent="menu_merchandizer_reporting_root"
        action="action_merchandizer_report_wizard"
        sequence="10"/>

    <menuitem
        id="menu_memorised_merchandizer_report"
        name="Merchandizer Sales Analysis"
        parent="memorised_reports.menu_mavazi_by_safeway_reports"
        action="action_merchandizer_report_wizard"
        sequence="40"/>
</odoo>