<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_x_merchandizer_sales_list" model="ir.ui.view">
        <field name="name">x_merchandizer.sales.list</field>
        <field name="model">x_merchandizer.sales</field>
        <field name="arch" type="xml">
            <list string="Merchandizers">
                <field name="code"/>
                <field name="name"/>
                <field name="mobile"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_x_merchandizer_sales_form" model="ir.ui.view">
        <field name="name">x_merchandizer.sales.form</field>
        <field name="model">x_merchandizer.sales</field>
        <field name="arch" type="xml">
            <form string="Merchandizer">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. John Doe"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="mobile"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_merchandizer" model="ir.actions.act_window">
        <field name="name">Merchandizers</field>
        <field name="res_model">x_merchandizer.sales</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_merchandizer_list"
        name="Merchandizers"
        parent="point_of_sale.menu_point_root"
        action="action_merchandizer"
        sequence="90"
    />
</odoo>