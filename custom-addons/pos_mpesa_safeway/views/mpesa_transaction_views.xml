<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mpesa_transaction_tree" model="ir.ui.view">
        <field name="name">mpesa.transaction.tree</field>
        <field name="model">mpesa.transaction</field>
        <field name="arch" type="xml">
            <list string="M-Pesa Transactions" decoration-info="state == 'available'" decoration-muted="state == 'used'">
                <field name="received_at" string="Received At"/>
                <field name="trans_id" string="M-Pesa Code"/>
                <field name="name" string="Customer Name"/>
                <field name="number" string="Phone Number"/>
                <field name="amount" sum="Total Amount"/>
                <field name="state" widget="badge" decoration-success="state == 'available'" decoration-danger="state == 'used'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_mpesa_transaction" model="ir.actions.act_window">
        <field name="name">M-Pesa Transactions</field>
        <field name="res_model">mpesa.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No M-Pesa transactions found.
            </p>
            <p>
                Transactions will appear here once the Safaricom callback is received.
            </p>
        </field>
    </record>

    <menuitem id="menu_mpesa_transactions" 
              name="M-Pesa Payments" 
              parent="point_of_sale.menu_point_config_product" 
              action="action_mpesa_transaction" 
              sequence="100"/>
</odoo>