<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_mpesa" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.mpesa</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <group string="M-Pesa Configuration" invisible="use_payment_terminal != 'mpesa'">
                    <group>
                        <field name="mpesa_type" required="use_payment_terminal == 'mpesa'"/>
                        <field name="mpesa_shortcode" required="use_payment_terminal == 'mpesa'"/>
                    </group>
                    <group>
                        <field name="mpesa_consumer_key" required="use_payment_terminal == 'mpesa'"/>
                        <field name="mpesa_consumer_secret" required="use_payment_terminal == 'mpesa'" password="True"/>
                        <field name="mpesa_passkey" 
                               invisible="mpesa_type != 'stk'" 
                               required="use_payment_terminal == 'mpesa' and mpesa_type == 'stk'" 
                               password="True"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>