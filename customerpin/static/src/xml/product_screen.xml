<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="customerpin.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <button class="control-button btn btn-light" 
                    t-on-click="onClickCustomerPin"
                    style="background-color: #28a745; color: white; border-color: #28a745;">
                <i class="fa fa-lock me-2"/>
                <span>Customer PIN (F9)</span>
            </button>
        </xpath>
    </t>
</templates>