<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action (PDF) -->
    <record id="action_customer_pin_report_pdf" model="ir.actions.report">
        <field name="name">Customer PIN Report PDF</field>
        <field name="model">customer.pin.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customerpin.report_customer_pin_template</field>
        <field name="binding_model_id" ref="model_customer_pin_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report Action (Web) -->
    <record id="action_customer_pin_report_web" model="ir.actions.report">
        <field name="name">Customer PIN Report Web</field>
        <field name="model">customer.pin.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">customerpin.report_customer_pin_template</field>
        <field name="binding_model_id" ref="model_customer_pin_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Wizard Form -->
    <record id="view_customer_pin_report_wizard_form" model="ir.ui.view">
        <field name="name">customer.pin.report.wizard.form</field>
        <field name="model">customer.pin.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer PIN Report">
                <sheet>
                    <group>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                        </group>
                        <group>
                            <field name="customer_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="print_pdf" string="Print PDF" type="object" class="btn-primary" icon="fa-print"/>
                    <button name="view_web" string="View Web" type="object" class="btn-secondary" icon="fa-list"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_customer_pin_report_wizard" model="ir.actions.act_window">
        <field name="name">Customer PIN Report</field>
        <field name="res_model">customer.pin.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_customer_pin_report_wizard"
              name="Customer PIN Report"
              parent="point_of_sale.menu_point_rep"
              action="action_customer_pin_report_wizard"
              sequence="30"/>

    <!-- Unified Report Template (PDF + Web) -->
    <template id="report_customer_pin_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page" style="font-family: 'Helvetica', sans-serif; color: #333; padding: 20px;">
                    
                    <!-- Company Header -->
                    <div class="row">
                        <div class="col-6">
                            <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" 
                                 style="max-height: 85px;" alt="Company Logo"/>
                            <div class="mt-2" style="font-size: 14px; line-height: 1.3;">
                                <strong t-field="res_company.name"/><br/>
                                <span t-field="res_company.country_id.name"/>
                            </div>
                        </div>
                    </div>

                    <!-- Report Title -->
                    <div class="text-center" style="margin-top: 40px; margin-bottom: 30px;">
                        <h2 style="color: #6a4d8a; font-weight: normal; font-size: 32px;">
                            Customer PIN Report
                        </h2>
                        <h5 style="font-weight: normal; margin-top: 10px;">
                            Period: <span t-esc="data.get('date_from', 'N/A')"/> to <span t-esc="data.get('date_to', 'N/A')"/>
                        </h5>
                    </div>

                    <!-- Filters -->
                    <div style="border: 1px solid #dee2e6; padding: 12px 20px; margin-bottom: 25px; display: flex; justify-content: space-between; font-size: 14px; background: #fff;">
                        <div><strong>Staff:</strong> <span t-esc="filters.get('staff', 'All Merchandizers')"/></div>
                        <div><strong>Records:</strong> <span t-esc="filters.get('records', 'All PIN Records')"/></div>
                    </div>

                    <!-- Table -->
                    <table class="table table-sm" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #000; font-size: 14px;">
                                <th class="text-start" style="width: 20%;">Reference</th>
                                <th class="text-start" style="width: 15%;">Date</th>
                                <th class="text-start" style="width: 25%;">Customer PIN Name</th>
                                <th class="text-end" style="width: 20%;">VAT</th>
                                <th class="text-end" style="width: 20%;">Total</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 13px;">
                            <t t-foreach="lines" t-as="line">
                                <tr style="border-bottom: 1px solid #eee;">
                                    <td><span t-esc="line.get('ref')"/></td>
                                    <td><span t-esc="line.get('date')"/></td>
                                    <td><span t-esc="line.get('customer_name', '')"/></td>
                                    <td class="text-end">
                                        <span t-esc="line.get('vat')" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="line.get('total')" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot style="border-top: 2px solid #000; font-weight: bold; font-size: 14px;">
                            <tr>
                                <td colspan="3" class="text-end" style="padding-top: 10px;">Grand Totals:</td>
                                <td class="text-end">
                                    <span t-esc="totals.get('vat', 0.0)" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="totals.get('total', 0.0)" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
