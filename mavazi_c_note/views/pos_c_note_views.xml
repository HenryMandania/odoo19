<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_c_note_list" model="ir.ui.view">
        <field name="name">pos.c.note.list</field>
        <field name="model">pos.c.note</field>
        <field name="arch" type="xml">
            <list string="C-Notes" 
                  decoration-success="state == 'active'" 
                  decoration-info="state == 'used'" 
                  decoration-danger="state == 'expired'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="original_amount" widget="monetary"/>
                <field name="remaining_amount" widget="monetary"/>
                <field name="expiry_date"/>
                <field name="state" 
                       widget="badge" 
                       decoration-success="state == 'active'" 
                       decoration-info="state == 'used'" 
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_pos_c_note_form" model="ir.ui.view">
        <field name="name">pos.c.note.form</field>
        <field name="model">pos.c.note</field>
        <field name="arch" type="xml">
            <form string="C-Note">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,used"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="original_amount" widget="monetary"/>
                            <field name="remaining_amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="expiry_date"/>
                            <field name="source_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Usage History" name="usage">
                            <field name="redeemed_order_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_pos_c_note" model="ir.actions.act_window">
        <field name="name">Store Credit (C-Notes)</field>
        <field name="res_model">pos.c.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pos_c_note" 
              name="C-Notes" 
              parent="point_of_sale.menu_point_of_sale" 
              action="action_pos_c_note" 
              sequence="20"/>
</odoo>