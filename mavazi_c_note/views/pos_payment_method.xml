<odoo>
    <!-- Your payment method definition -->
    <record id="pos_payment_method_cnote" model="pos.payment.method">
        <field name="name">C-Note / Store Credit</field>
        <field name="is_cash_count" eval="False"/>
    </record>

    <!-- Template override for Validate button -->
    <template id="cnote_payment_screen_patch" inherit_id="point_of_sale.PaymentScreen">
        <xpath expr="//button[contains(@class,'validate')]" position="attributes">
            <attribute name="t-att-disabled">false</attribute>
        </xpath>
    </template>
</odoo>
