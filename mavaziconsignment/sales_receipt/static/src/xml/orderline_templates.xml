<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]/div" position="replace">
            <div class="d-flex flex-column w-100">
                <div class="text-uppercase" style="font-weight: normal; line-height: 1.2;">
                    <t t-esc="vals.name"/>
                </div>
                <div t-if="vals.default_code" class="text-muted" style="font-size: 0.8em; font-weight: normal;">
                    Code: <t t-esc="vals.default_code"/>
                </div>
                <small t-if="vals.attributeString" t-out="vals.attributeString" class="attribute-line fst-italic text-muted" />
            </div>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_receipt_footer')]" position="inside">
            <div class="text-center mt-3 pt-2 border-top" style="font-size: 0.8em;">
                <div>Powered by Goonertech ICT Services Ltd</div>
                <div>henrymandania9@gmail.com</div>
            </div>
        </xpath>
        <xpath expr="//div[@t-if='!props.minimal']" position="replace">
             <div t-if="!props.minimal" class="d-none"></div>
        </xpath>
    </t>
</templates>