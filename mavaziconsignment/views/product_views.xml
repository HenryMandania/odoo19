<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_form_consignment_inherit" model="ir.ui.view">
        <field name="name">product.template.form.consignment</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Consignment toggle after type -->
            <xpath expr="//field[@name='type']" position="after">
                <field name="x_is_consignment" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
