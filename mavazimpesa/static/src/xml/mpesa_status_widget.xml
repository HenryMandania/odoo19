<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="mavazimpesa.MpesaStatusWidget" owl="1">
        <div class="oe_status mpesa-status-widget" t-on-click="toggleDetails">
            
            <!-- Icon -->
            <div class="oe_icon">
                <i t-attf-class="fa fa-mobile {{ state.count > 0 ? 'text-success' : 'text-muted' }}"/>
            </div>
            
            <!-- Payment count badge -->
            <div t-if="state.count > 0" class="oe_label badge bg-danger">
                <t t-esc="state.count"/>
            </div>

            <!-- Dropdown with unclaimed payments -->
            <div t-if="state.showDetails" class="mpesa-dropdown">
                <div class="mpesa-header">Unclaimed Payments</div>

                <!-- List payments if any -->
                <t t-if="state.payments.length > 0">
                    <t t-foreach="state.payments" t-as="payment" t-key="payment.id">
                        <div class="mpesa-item">
                            <div class="mpesa-code"><t t-esc="payment.name"/></div>
                            <div class="mpesa-amount">KES <t t-esc="payment.amount"/></div>
                        </div>
                    </t>
                </t>

                <!-- Empty state -->
                <div t-else="" class="mpesa-empty">
                    No new payments
                </div>
            </div>
        </div>
    </t>
</templates>