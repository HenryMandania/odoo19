<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mpesa_transaction_list" model="ir.ui.view">
        <field name="name">mpesa.transaction.list</field>
        <field name="model">mpesa.transaction</field>
        <field name="arch" type="xml">
            <list string="Mpesa Transactions" 
                  decoration-success="state == 'closed'" 
                  decoration-info="state == 'open'"
                  sample="1">
                <field name="payment_date" widget="remaining_days" optional="show"/>
                <field name="name" string="Mpesa Code"/>
                <field name="phone_number"/>
                <field name="amount" sum="Total Amount"/>
                <field name="ref_number" optional="hide"/>
                <field name="state" 
                       widget="badge" 
                       decoration-success="state == 'closed'" 
                       decoration-info="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="view_mpesa_transaction_form" model="ir.ui.view">
        <field name="name">mpesa.transaction.form</field>
        <field name="model">mpesa.transaction</field>
        <field name="arch" type="xml">
            <form string="Mpesa Transaction" edit="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Mpesa Receipt Number"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Payment Info">
                            <field name="amount"/>
                            <field name="phone_number"/>
                            <field name="payment_date"/>
                        </group>
                        <group string="Consumption Info">
                            <field name="pos_config_id"/>
                            <field name="consumption_date"/>
                            <field name="pos_payment_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mpesa_transaction" model="ir.actions.act_window">
        <field name="name">Mpesa Transactions</field>
        <field name="res_model">mpesa.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

<menuitem id="menu_mpesa_root" 
              name="Mpesa" 
              web_icon="mavazimpesa,static/description/icon.png" 
              sequence="50"/>

    <record id="action_mpesa_transaction" model="ir.actions.act_window">
        <field name="name">Mpesa Transactions</field>
        <field name="res_model">mpesa.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mpesa_transactions" 
              name="Transactions" 
              parent="menu_mpesa_root" 
              action="action_mpesa_transaction" 
              sequence="10"/>
</odoo>