<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pos_order_list_inherit" model="ir.ui.view">
            <field name="name">pos.order.list.inherit.merchandizer</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='session_id']" position="after">
                    <field name="merchandizer_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="view_pos_order_form_inherit" model="ir.ui.view">
            <field name="name">pos.order.form.inherit.merchandizer</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="merchandizer_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>