<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_mpesa_report_pdf" model="ir.actions.report">
        <field name="name">MPESA Transactions (PDF)</field>
        <field name="model">mpesa.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_safaricom.mpesa_report_template</field>
        <field name="report_file">pos_safaricom.mpesa_report_template</field>
        <field name="binding_model_id" ref="model_mpesa_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_mpesa_report_html" model="ir.actions.report">
        <field name="name">MPESA Transactions (Web)</field>
        <field name="model">mpesa.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">pos_safaricom.mpesa_report_template</field>
        <field name="report_file">pos_safaricom.mpesa_report_template</field>
    </record>

    <template id="mpesa_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">MPESA Transactions Report</h2>
                        
                        <div class="row mt-4 mb-4" style="border: 1px solid #dee2e6; padding: 10px; background-color: #f8f9fa;">
                            <div class="col-6">
                                <strong>Period:</strong> <span t-field="o.date_from"/> to <span t-field="o.date_to"/><br/>
                                <strong>Company:</strong> <span t-field="o.company_id.name"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Status:</strong> <t t-esc="o.status or 'All'"/><br/>
                                <strong>Printed On:</strong> <t t-esc="datetime.datetime.now().strftime('%Y-%m-%d')"/>
                            </div>
                        </div>

                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Trans ID</th>
                                    <th>Customer</th>
                                    <th>Phone</th>
                                    <th class="text-end">Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.get_report_data()" t-as="line">
                                    <tr>
                                        <td><span t-field="line.received_at"/></td>
                                        <td><span t-field="line.trans_id"/></td>
                                        <td><span t-field="line.name"/></td>
                                        <td><span t-field="line.number"/></td>
                                        <td class="text-end"><span t-field="line.amount"/></td>
                                        <td><span t-field="line.status"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>