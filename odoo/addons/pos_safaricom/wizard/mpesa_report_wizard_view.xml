<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mpesa_report_wizard_form" model="ir.ui.view">
        <field name="name">mpesa.report.wizard.form</field>
        <field name="model">mpesa.report.wizard</field>
        <field name="arch" type="xml">
            <form string="MPESA Report">
                <group>
                    <group>
                        <field name="date_from" string="Start Date"/>
                        <field name="date_to" string="End Date"/>
                    </group>
                    <group>
                        <field name="status"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button name="action_view_html" string="View on Web" type="object" class="btn-info"/>
                    <button name="action_print_excel" string="View for Excel" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mpesa_report_wizard" model="ir.actions.act_window">
        <field name="name">MPESA Report</field>
        <field name="res_model">mpesa.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_mpesa_report_wizard"
              name="MPESA Transactions"
              action="action_mpesa_report_wizard"
              parent="point_of_sale.menu_point_rep"
              sequence="100"/>
</odoo>