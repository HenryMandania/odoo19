<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List (Grid) View -->
    <record id="view_mpesa_provider_list" model="ir.ui.view">
        <field name="name">mpesa.provider.list</field>
        <field name="model">mpesa.provider</field>
        <field name="arch" type="xml">
            <list string="M-Pesa Configurations">
                <field name="name"/>
                <field name="mpesa_environment"/>
                <field name="business_shortcode"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_mpesa_provider_form" model="ir.ui.view">
        <field name="name">mpesa.provider.form</field>
        <field name="model">mpesa.provider</field>
        <field name="arch" type="xml">
            <form string="M-Pesa Configuration">
                <sheet>
                    <group>
                        <group name="credentials" string="Credentials">
                            <field name="name"/>
                            <field name="mpesa_environment" widget="radio"/>
                            <field name="consumer_key"/>
                            <field name="consumer_secret"/>
                        </group>
                        <group name="lnm" string="M-Pesa Details">
                            <field name="business_shortcode"/>
                            <field name="passkey"/>
                            <field name="callback_url"/>
                            <field name="transaction_type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mpesa_provider" model="ir.actions.act_window">
        <field name="name">M-Pesa Settings</field>
        <field name="res_model">mpesa.provider</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_mpesa_config_root"
              name="M-Pesa"
              parent="point_of_sale.menu_point_config_product"
              sequence="10"/>
    <menuitem id="menu_mpesa_provider"
              name="Settings"
              parent="menu_mpesa_config_root"
              action="action_mpesa_provider"
              sequence="10"/>
</odoo>
