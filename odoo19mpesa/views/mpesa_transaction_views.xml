<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mpesa_transaction_list" model="ir.ui.view">
        <field name="name">mpesa.transaction.list</field>
        <field name="model">mpesa.transaction</field>
        <field name="arch" type="xml">
            <list string="M-Pesa Transactions" decoration-info="state == 'open'" decoration-success="state == 'closed'" decoration-danger="state == 'failed'">
                <field name="create_date" string="Initiated"/>
                <field name="customer_name"/>
                <field name="phone"/>
                <field name="amount" sum="Total Amount"/>
                <field name="receipt_no"/>
                <field name="mpesa_mode"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_mpesa_transaction_form" model="ir.ui.view">
        <field name="name">mpesa.transaction.form</field>
        <field name="model">mpesa.transaction</field>
        <field name="arch" type="xml">
            <form string="M-Pesa Transaction">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="open,committed,closed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Payment Details">
                            <field name="customer_name"/>
                            <field name="phone"/>
                            <field name="amount"/>
                            <field name="receipt_no"/>
                            <field name="payment_date"/>
                        </group>
                        <group string="Reference &amp; Source">
                            <field name="checkout_id"/>
                            <field name="pos_reference"/>
                            <field name="mpesa_mode"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mpesa_transaction" model="ir.actions.act_window">
        <field name="name">M-Pesa Transactions</field>
        <field name="res_model">mpesa.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mpesa_transactions" 
              name="Transactions" 
              parent="menu_mpesa_config_root" 
              action="action_mpesa_transaction" 
              sequence="20"/>
</odoo>