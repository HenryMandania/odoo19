<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        
        <xpath expr="//div[hasclass('pos-receipt')]/div[hasclass('pos-receipt-header')]" position="replace">
            <div class="pos-receipt-header" style="text-align:center; font-size:12px;">
                <div style="font-weight:bold;">SALES RECEIPT</div>
                <br/>
                <div style="font-weight:bold;">Mavazi By Safeway</div>
                <div>----------------------------------</div>
                <div style="font-weight:bold;">SAFEWAY HYPERMARKETS LTD</div>
                <br/>
                <div>PO BOX 55070-00200 - NAIROBI</div>
                <div>PIN: P051092499K</div>
                <div>Mobile: 0790324203 / 0701780418</div>
                <div>Email: info@safewaykenya.com</div>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('pos-receipt-footer')]" position="replace">
            <div class="pos-receipt-footer" style="text-align:center; margin-top:10px; font-size:12px;">
                <div style="font-weight:bold;">
                    Thank you for Shopping at Mavazi at Safeway
                </div>
            </div>
        </xpath>

    </t>
</templates>